# ContextCheck Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Settings
ENVIRONMENT=development
APP_NAME=ContextCheck
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Security (Replace with a strong random key in production)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./contextcheck.db

# Android Client Config Helper:
# For Android Emulator: http://10.0.2.2:8000
# For Physical Device: http://<YOUR_PC_LAN_IP>:8000 (e.g. http://192.168.1.100:8000)
API_BASE_URL=http://10.0.2.2:8000
